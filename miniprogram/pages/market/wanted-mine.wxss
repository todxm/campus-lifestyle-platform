.contact-card,
.contact-mini,
.empty-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.contact-title {
  color: #203327;
  font-size: 30rpx;
  font-weight: 900;
}

.contact-desc {
  margin: 8rpx 0 20rpx;
  color: #74806f;
  font-size: 24rpx;
}

input {
  width: 100%;
  box-sizing: border-box;
  min-height: 82rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #fff9ec;
  color: #203327;
  font-size: 27rpx;
}

.placeholder {
  color: #b4aa94;
}

.save-btn {
  margin-top: 18rpx;
  min-height: 76rpx;
  border-radius: 999rpx;
  background: #1e8a55;
  color: #fff;
  font-size: 27rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-mini {
  color: #74806f;
  font-size: 25rpx;
}

.wanted-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.wanted-card {
  padding: 26rpx;
  background: linear-gradient(135deg, #fff8df 0%, #ffffff 100%);
}

.wanted-top {
  display: flex;
  gap: 12rpx;
}

.status-tag {
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e8f7ef;
  color: #16885a;
  font-size: 22rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
}

.wanted-title {
  margin-top: 16rpx;
  color: #203327;
  font-size: 32rpx;
  font-weight: 900;
}

.wanted-desc {
  margin-top: 10rpx;
  color: #74806f;
  font-size: 25rpx;
  line-height: 1.6;
}

.wanted-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
  color: #e05d2f;
  font-size: 24rpx;
  font-weight: 900;
}

.empty-card {
  color: #74806f;
  text-align: center;
}

.empty-icon {
  font-size: 54rpx;
}

.empty-title {
  margin-top: 14rpx;
  color: #203327;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
