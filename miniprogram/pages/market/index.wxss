.tab-card {
  display: flex;
  gap: 10rpx;
  padding: 10rpx;
}

.tab-item {
  flex: 1;
  min-height: 68rpx;
  border-radius: 999rpx;
  color: #66735f;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item.active {
  background: #1e8a55;
  color: #fff;
}

.category-scroll {
  margin-top: 22rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 14rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #fffdf7;
  color: #66735f;
  font-size: 24rpx;
  font-weight: 700;
}

.category-chip.active {
  background: #fff0bd;
  color: #9a6500;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.goods-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  padding: 26rpx;
}

.goods-info {
  flex: 1;
}

.goods-name {
  font-size: 32rpx;
  font-weight: 900;
}

.goods-note {
  margin: 10rpx 0 16rpx;
  color: #74806f;
  font-size: 25rpx;
  line-height: 1.5;
}

.goods-price {
  flex: none;
  color: #e05d2f;
  font-size: 34rpx;
  font-weight: 900;
}

.wanted-label {
  flex: none;
  color: #a15c00;
  font-size: 28rpx;
  font-weight: 900;
}

.wanted-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-top: 26rpx;
}

.wanted-title {
  color: #203327;
  font-size: 34rpx;
  font-weight: 900;
}

.wanted-subtitle {
  margin-top: 6rpx;
  color: #74806f;
  font-size: 24rpx;
}

.publish-wanted-btn,
.empty-btn {
  flex: none;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #1e8a55;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wanted-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx;
  background: linear-gradient(135deg, #fff8df 0%, #ffffff 100%);
}

.wanted-card::after {
  content: "";
  position: absolute;
  right: -30rpx;
  bottom: -36rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(255, 204, 82, 0.18);
}

.wanted-card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.status-tag {
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e8f7ef;
  color: #16885a;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
}

.wanted-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #e05d2f;
  font-size: 24rpx;
  font-weight: 900;
}

.wanted-time {
  margin-top: 12rpx;
  color: #9aa390;
  font-size: 22rpx;
}

.empty-card {
  padding: 42rpx 28rpx;
  color: #74806f;
  text-align: center;
}

.empty-icon {
  font-size: 54rpx;
}

.empty-title {
  margin-top: 14rpx;
  color: #203327;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin: 12rpx 0 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
