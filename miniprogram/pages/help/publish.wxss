.publish-page {
  padding-top: 34rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.publish-hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  min-height: 184rpx;
  box-sizing: border-box;
  padding: 34rpx 30rpx;
  border-radius: 46rpx;
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 228, 148, 0.78) 0, rgba(255, 228, 148, 0) 138rpx),
    linear-gradient(135deg, #fffdf7 0%, #fff3c9 52%, #eaf6ff 100%);
  box-shadow: 0 18rpx 44rpx rgba(98, 81, 42, 0.1);
}

.publish-hero .page-subtitle {
  margin-bottom: 0;
}

.publish-hero-icon {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(5deg);
}

.time-tip-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.tip-title {
  color: #101b16;
  font-size: 31rpx;
  font-weight: 900;
}

.tip-times {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.tip-times view {
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff0c8;
  color: #a15c00;
  font-size: 23rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
}

.tip-desc {
  margin-top: 16rpx;
  color: #7b846f;
  font-size: 23rpx;
  line-height: 1.55;
}

.form-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.form-section-title {
  color: #101b16;
  font-size: 30rpx;
  font-weight: 900;
}

.form-section-title.second {
  margin-top: 34rpx;
}

.form-item {
  margin-top: 22rpx;
}

.form-item.two-column {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #203327;
  font-size: 25rpx;
  font-weight: 900;
}

input,
textarea,
.picker-value,
.reward-stepper {
  width: 100%;
  min-height: 76rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #f8f3e8;
  color: #203327;
  font-size: 27rpx;
  padding: 0 22rpx;
}

input,
.picker-value,
.reward-stepper {
  display: flex;
  align-items: center;
}

textarea {
  min-height: 156rpx;
  padding-top: 20rpx;
  line-height: 1.5;
}

.picker-value {
  justify-content: space-between;
}

.picker-value.small {
  min-height: 72rpx;
  font-size: 25rpx;
}

.picker-arrow {
  color: #9aa390;
  font-size: 38rpx;
  line-height: 1;
}

.placeholder {
  color: #9aa390;
}

.field-hint {
  margin-top: 10rpx;
  color: #8b947d;
  font-size: 22rpx;
  line-height: 1.45;
}

.reward-stepper {
  justify-content: space-between;
  padding: 10rpx 14rpx;
}

.step-btn {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #24975f;
  font-size: 34rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-btn.plus {
  background: #24975f;
  color: #ffffff;
}

.reward-value {
  color: #e05d2f;
  font-size: 34rpx;
  font-weight: 900;
}

.submit-btn {
  margin-top: 28rpx;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #24975f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(36, 151, 95, 0.18);
}

.submit-btn.loading {
  background: #9ecab2;
  box-shadow: none;
}

.bottom-tip {
  margin: 26rpx 8rpx 0;
  color: #7b846f;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}
