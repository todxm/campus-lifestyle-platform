.detail-page {
  padding-top: 34rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.detail-hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  min-height: 184rpx;
  box-sizing: border-box;
  padding: 34rpx 30rpx;
  border-radius: 46rpx;
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 228, 148, 0.78) 0, rgba(255, 228, 148, 0) 138rpx),
    linear-gradient(135deg, #fffdf7 0%, #fff3c9 52%, #e8f7de 100%);
  box-shadow: 0 18rpx 44rpx rgba(98, 81, 42, 0.1);
}

.detail-hero .page-subtitle {
  margin-bottom: 0;
}

.detail-hero-icon {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(5deg);
}

.loading-card,
.status-card,
.info-card,
.action-card,
.closed-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.status-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.task-type,
.task-status {
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
}

.task-type {
  background: #e8f8ef;
  color: #24975f;
}

.task-status.waiting {
  background: #fff0c8;
  color: #a15c00;
}

.task-status.taken {
  background: #eaf4ff;
  color: #2f6db0;
}

.task-status.done {
  background: #e8f8ef;
  color: #24975f;
}

.task-status.cancelled {
  background: #f0eee5;
  color: #8b947d;
}

.route-title {
  margin-top: 26rpx;
  color: #101b16;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.25;
}

.route-subtitle {
  margin-top: 12rpx;
  color: #7b846f;
  font-size: 25rpx;
  line-height: 1.5;
}

.reward-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
}

.reward {
  color: #e05d2f;
  font-size: 42rpx;
  font-weight: 900;
}

.time-slot {
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffe7ac;
  color: #8a5200;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
}

.card-title {
  color: #101b16;
  font-size: 31rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(111, 124, 101, 0.12);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex: none;
  color: #7b846f;
  font-size: 24rpx;
  font-weight: 800;
}

.info-value {
  flex: 1;
  color: #203327;
  font-size: 25rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.remark-box {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #f8f3e8;
  color: #66705d;
  font-size: 25rpx;
  line-height: 1.55;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.primary-action,
.danger-action {
  min-height: 82rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-action {
  background: #24975f;
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(36, 151, 95, 0.18);
}

.danger-action {
  background: #fff3ee;
  color: #d85b38;
  border: 2rpx solid rgba(216, 91, 56, 0.28);
}

.action-note,
.closed-desc {
  margin-top: 18rpx;
  color: #7b846f;
  font-size: 23rpx;
  line-height: 1.55;
}

.closed-title {
  color: #101b16;
  font-size: 31rpx;
  font-weight: 900;
}
