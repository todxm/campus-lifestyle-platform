.service-detail-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.detail-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #fff7dc 0%, #e8f7ff 100%);
}

.detail-hero-icon {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  background: #ffffff;
  font-size: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 32rpx rgba(47, 109, 176, 0.12);
}

.detail-card {
  overflow: hidden;
  margin-top: 24rpx;
}

.detail-cover {
  width: 100%;
  height: 330rpx;
}

.detail-cover-placeholder {
  width: 100%;
  height: 260rpx;
  color: #16885a;
  font-size: 40rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 24% 35%, rgba(255, 207, 82, 0.36) 0, rgba(255, 207, 82, 0) 90rpx),
    radial-gradient(circle at 72% 56%, rgba(133, 209, 160, 0.32) 0, rgba(133, 209, 160, 0) 120rpx),
    #f6fbef;
}

.detail-body {
  padding: 28rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.tag-green {
  background: #e7f7ee;
  color: #16885a;
}

.service-name {
  color: #203327;
  font-size: 38rpx;
  font-weight: 900;
}

.service-desc {
  margin-top: 16rpx;
  color: #6f7a68;
  font-size: 26rpx;
  line-height: 1.7;
}

.info-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  color: #6f7a68;
  font-size: 25rpx;
  line-height: 1.5;
}

.info-row text:first-child {
  flex: none;
  color: #203327;
  font-weight: 900;
}

.info-row text:last-child {
  text-align: right;
}

.contact-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.contact-title {
  color: #203327;
  font-size: 32rpx;
  font-weight: 900;
}

.contact-desc,
.contact-value {
  margin-top: 12rpx;
  color: #6f7a68;
  font-size: 25rpx;
  line-height: 1.6;
}

.contact-value {
  color: #16885a;
  font-weight: 900;
}

.contact-btn {
  margin-top: 24rpx;
}

.empty-card {
  margin-top: 24rpx;
  padding: 42rpx 28rpx;
  color: #74806f;
  text-align: center;
}

.empty-title {
  color: #203327;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
