.wall-detail-page {
  padding-top: 34rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.detail-hero {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  min-height: 184rpx;
  box-sizing: border-box;
  padding: 34rpx 30rpx;
  border-radius: 46rpx;
  background:
    radial-gradient(circle at 88% 18%, rgba(255, 228, 148, 0.78) 0, rgba(255, 228, 148, 0) 138rpx),
    linear-gradient(135deg, #fffdf7 0%, #fff3c9 52%, #eaf4ff 100%);
  box-shadow: 0 18rpx 44rpx rgba(98, 81, 42, 0.1);
}

.detail-hero .page-subtitle {
  margin-bottom: 0;
}

.detail-hero-icon {
  flex: none;
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(5deg);
}

.loading-card,
.main-card,
.closed-card,
.info-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.main-card {
  position: relative;
  overflow: hidden;
}

.main-card::after {
  content: "";
  position: absolute;
  right: -38rpx;
  top: -38rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  opacity: 0.65;
}

.main-card.lost::after {
  background: #ffe0b6;
}

.main-card.question::after {
  background: #dff0ff;
}

.main-card.news::after {
  background: #dcf7e6;
}

.post-top,
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.tag,
.status,
.post-tag {
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
}

.tag.lost {
  background: #fff0c8;
  color: #a15c00;
}

.tag.question {
  background: #eaf4ff;
  color: #2f6db0;
}

.tag.news {
  background: #e8f8ef;
  color: #24975f;
}

.status {
  background: #e8f8ef;
  color: #24975f;
}

.status.closed {
  background: #f1eee7;
  color: #8a8172;
}

.post-title {
  margin-top: 24rpx;
  color: #101b16;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.3;
}

.post-content {
  margin-top: 18rpx;
  color: #3f4d43;
  font-size: 28rpx;
  line-height: 1.75;
}

.post-tag {
  width: fit-content;
  margin-top: 22rpx;
  background: #f8f3e8;
  color: #6f7669;
}

.closed-title {
  color: #101b16;
  font-size: 30rpx;
  font-weight: 900;
}

.closed-desc {
  margin-top: 10rpx;
  color: #7b846f;
  font-size: 24rpx;
  line-height: 1.55;
}

.info-row + .info-row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(48, 61, 48, 0.08);
}

.info-label {
  flex: none;
  color: #7b846f;
  font-size: 25rpx;
  font-weight: 800;
}

.info-value {
  color: #203327;
  font-size: 26rpx;
  font-weight: 800;
  text-align: right;
}
