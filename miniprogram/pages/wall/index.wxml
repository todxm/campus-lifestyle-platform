<view class="page safe-bottom">
  <view class="page-title">校园墙</view>
  <view class="page-subtitle">上海路今天的小消息、小问题、小互助都可以先放这里。</view>

  <scroll-view class="channel-scroll" scroll-x="true" show-scrollbar="false">
    <view class="channel-row">
      <view
        class="channel-chip {{activeChannel === item ? 'active' : ''}}"
        wx:for="{{channels}}"
        wx:key="*this"
        data-channel="{{item}}"
        bindtap="changeChannel"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <view class="loading-card soft-card" wx:if="{{isLoading}}">正在加载校园墙...</view>

  <view class="post-list" wx:if="{{!isLoading && posts.length > 0}}">
    <view
      class="post-card soft-card {{item.typeClass}}"
      wx:for="{{posts}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openPostDetail"
    >
      <view class="post-top">
        <view class="tag {{item.typeClass}}">{{item.postType}}</view>
        <view class="post-time">{{item.createdTime}}</view>
      </view>
      <view class="post-title">{{item.title}}</view>
      <view class="post-content">{{item.content}}</view>
      <view class="post-meta">
        <view class="post-tag">{{item.tag}}</view>
        <view class="post-location" wx:if="{{item.location}}">📍 {{item.location}}</view>
      </view>
    </view>
  </view>

  <view class="empty-card soft-card" wx:if="{{!isLoading && posts.length === 0}}">
    <view class="empty-icon">📌</view>
    <view class="empty-title">还没有校园墙内容</view>
    <view class="empty-desc">可以先发一条失物招领、新生问题或校园提醒。</view>
    <view class="empty-btn" bindtap="publishPost">发布一条</view>
  </view>

  <view class="publish-fab" bindtap="publishPost">发布</view>
</view>
